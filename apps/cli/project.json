{
  "name": "cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cli/src",
  "targets": {
    "refresh-manifests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oclif manifest",
        "cwd": "apps/cli"
      }
    },
    "refresh-readme": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm oclif readme",
        "cwd": "apps/cli"
      }
    },
    "build": {
      "executor": "@storm-software/workspace-tools:tsup-node",
      "dependsOn": [
        "refresh-manifests",
        "refresh-readme",
        "^build"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/cli",
        "main": "apps/cli/bin/acidic.ts",
        "tsConfig": "apps/cli/tsconfig.json",
        "project": "apps/cli/package.json",
        "defaultConfiguration": "production",
        "external": [
          "pnpapi"
        ]
      },
      "configurations": {
        "production": {
          "debug": false,
          "verbose": false
        },
        "development": {
          "debug": true,
          "verbose": true
        }
      }
    },
  }
}