{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@powerlines/tsconfig/recommended.json",
  "display": "Acidic - Monorepo",
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    // "isolatedDeclarations": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  }
}