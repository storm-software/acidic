{
  "name": "@acidic/binding",
  "version": "0.0.0",
  "private": false,
  "repository": {
    "type": "github",
    "url": "https://github.com/storm-software/acidic.git",
    "directory": "crates/acidic-binding"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">= 10"
  },
  "napi": {
    "name": "acidic-binding",
