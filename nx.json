{
  "extends": "@storm-software/workspace-tools/config/nx.json",
  "plugins": [
    "@nx/eslint/plugin",
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    "@storm-software/workspace-tools/plugins/rust",
    "@storm-software/workspace-tools/plugins/typescript"
  ],
  "generators": {
    "@nx/react": {
      "application": {
        "style": "css",
        "linter": "eslint",
        "bundler": "vite",
        "babel": true
      },
      "library": {
        "style": "css",
        "linter": "eslint",
        "unitTestRunner": "vitest"
      },
      "component": {
        "style": "css"
      }
    }
  }
}